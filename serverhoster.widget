{
  "name": "ServerHoster",
  "width": 250,
  "height": 380,
  "html": "<div class='header'>\n  <h3>ServerHoster</h3>\n  <div id='summary'>Connecting...</div>\n</div>\n<div id='services-list'></div>",
  "css": "body {\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n  background: rgba(20, 20, 25, 0.9);\n  color: #fff;\n  margin: 0;\n  padding: 15px;\n  border-radius: 12px;\n  border: 1px solid #444;\n  \n  \n}\nbody::-webkit-scrollbar {\n  width: 5px;\n}\nbody::-webkit-scrollbar-thumb {\n  background-color: #555;\n  border-radius: 5px;\n}\n.header {\n  border-bottom: 1px solid #444;\n  padding-bottom: 10px;\n  margin-bottom: 10px;\n  position: sticky;\n  top: 0;\n  background: rgba(20, 20, 25, 0.95);\n  z-index: 10;\n}\nh3 {\n  margin: 0;\n  color: #00ffcc;\n  font-size: 16px;\n}\n#summary {\n  font-size: 12px;\n  color: #aaa;\n  margin-top: 4px;\n}\n.service {\n  display: flex;\n  align-items: center;\n  margin-bottom: 8px;\n  font-size: 13px;\n}\n.status-dot {\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  margin-right: 8px;\n  flex-shrink: 0;\n}\n.running { background-color: #00ffcc; box-shadow: 0 0 5px #00ffcc; }\n.stopped { background-color: #ff4444; box-shadow: 0 0 5px #ff4444; }\n.other { background-color: #ffaa00; box-shadow: 0 0 5px #ffaa00; }\n.name {\n  flex-grow: 1;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.type {\n  font-size: 10px;\n  color: #888;\n  background: #333;\n  padding: 2px 6px;\n  border-radius: 4px;\n  flex-shrink: 0;\n}\n#services-list { overflow-y: auto; max-height: 280px; -webkit-app-region: no-drag; }\n#services-list::-webkit-scrollbar { width: 5px; }\n#services-list::-webkit-scrollbar-thumb { background-color: #555; border-radius: 5px; }",
  "js": "const { exec } = require('child_process');\n\nlet sshKey = 'C:/Users/tobia/.ssh/serverhoster_key';\nlet vpsUser = 'administrator@85.190.100.23';\nlet token = null;\nlet isFetching = false;\n\nfunction update() {\n    if (isFetching) return;\n    isFetching = true;\n    if (!token) {\n        document.getElementById('summary').innerText = 'Fetching token...';\n        const getTokenCmd = 'ssh -i ' + sshKey + ' -o BatchMode=yes -o ConnectTimeout=5 ' + vpsUser + ' \"sudo sqlite3 -readonly /root/.survhub/survhub.db \\'select token from sessions order by created_at desc limit 1;\\'\"';\n        exec(getTokenCmd, (err, stdout) => {\n            if (err) {\n                document.getElementById('summary').innerText = 'SSH connection failed';\n                isFetching = false;\n                return;\n            }\n            token = stdout.trim();\n            if (token) fetchServices();\n            else {\n                document.getElementById('summary').innerText = 'No token found';\n                isFetching = false;\n            }\n        });\n    } else {\n        fetchServices();\n    }\n}\n\nfunction fetchServices() {\n    document.getElementById('summary').innerText = 'Refreshing...';\n    const fetchCmd = 'ssh -i ' + sshKey + ' -o BatchMode=yes -o ConnectTimeout=5 ' + vpsUser + ' \"curl -s -H \\\"authorization: Bearer ' + token + '\\\" http://localhost:8787/services\"';\n    exec(fetchCmd, (err, stdout) => {\n        isFetching = false;\n        if (err) {\n            token = null;\n            document.getElementById('summary').innerText = 'Error fetching services';\n            return;\n        }\n        try {\n            const data = JSON.parse(stdout);\n            if (Array.isArray(data)) {\n                render(data);\n            } else if (data.error) {\n                token = null; \n                document.getElementById('summary').innerText = 'API Error: ' + data.error;\n            }\n        } catch(e) {\n            document.getElementById('summary').innerText = 'Invalid JSON from server';\n        }\n    });\n}\n\nfunction render(services) {\n    const running = services.filter(s => s.status === 'running').length;\n    document.getElementById('summary').innerText = running + ' / ' + services.length + ' services running';\n    \n    let html = '';\n    services.sort((a,b) => a.name.localeCompare(b.name)).forEach(s => {\n        let dotClass = 'other';\n        if (s.status === 'running') dotClass = 'running';\n        if (s.status === 'stopped' || s.status === 'failed') dotClass = 'stopped';\n        \n        html += '<div class=\"service\"><div class=\"status-dot ' + dotClass + '\"></div><div class=\"name\">' + s.name + '</div><div class=\"type\">' + s.type + '</div></div>';\n    });\n    \n    document.getElementById('services-list').innerHTML = html;\n}\n\nupdate();\nsetInterval(update, 15000);\n"
}