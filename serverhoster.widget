{
  "name": "ServerHoster",
  "width": 250,
  "height": 380,
  "html": "<div class='container'><div class='header'><div class='header-left'><span class='icon'>🖥️</span><h3>ServerHoster</h3></div><div class='header-right'><span id='summary' class='status-badge'>Connecting...</span><button class='no-drag refresh-btn' onclick='update()'>&#x21BB;</button></div></div><div id='services-list' class='no-drag'></div></div>",
  "css": "\n/* === wb-led-ladder: multi-color LED meter for service health === */\n.led-ladder-wrap { display: flex; flex-direction: row; gap: 2px; align-items: flex-end; height: 14px; }\n.led-seg { width: 6px; height: 14px; border-radius: 2px; opacity: 0.2; transition: opacity 0.2s, background 0.2s; }\n.led-seg.active.green { opacity: 1; background: #a6e3a1 !important; box-shadow: 0 0 4px #a6e3a1; }\n.led-seg.active.yellow { opacity: 1; background: #f9e2af !important; box-shadow: 0 0 4px #f9e2af; }\n.led-seg.active.red { opacity: 1; background: #f38ba8 !important; box-shadow: 0 0 4px #f38ba8; }\n\n/* === wb-status-badge: pulsing service status dots === */\n@keyframes wb-radar { 0% { transform: scale(1); opacity: 1; } 100% { transform: scale(3); opacity: 0; } }\n.status-dot {\n  position: relative;\n}\n.status-dot.running::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  background: #a6e3a1;\n  animation: wb-radar 1.8s ease-out infinite;\n}\n.status-dot.stopped::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  background: #f38ba8;\n  animation: wb-radar 2s ease-out infinite;\n}\n\n/* === wb-float: header float levitation === */\n@keyframes wb-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }\n.header { animation: wb-float 4s ease-in-out infinite; }\nbody {\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n  background: rgba(15, 15, 20, 0.95);\n  color: #e0e0e0;\n  margin: 0;\n  padding: 0;\n  border-radius: 12px;\n  border: 1px solid #333;\n  overflow: hidden;\n}\n.container {\n  display: flex;\n  flex-direction: column;\n  height: auto;\n  min-height: 0;\n}\n.header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12px 15px;\n  border-bottom: 1px solid #333;\n  background: rgba(20, 20, 25, 0.95);\n  position: sticky;\n  top: 0;\n  z-index: 10;\n}\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.icon { font-size: 18px; }\nh3 {\n  margin: 0;\n  color: #a6e3a1;\n  font-size: 15px;\n  font-weight: 600;\n}\n.header-right {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.status-badge {\n  font-size: 11px;\n  padding: 3px 8px;\n  border-radius: 10px;\n  background: #333;\n  color: #a6adc8;\n  font-weight: 600;\n}\n.refresh-btn {\n  background: none;\n  border: 1px solid #444;\n  color: #a6adc8;\n  font-size: 16px;\n  width: 28px;\n  height: 28px;\n  border-radius: 6px;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.2s;\n}\n.refresh-btn:hover {\n  background: #333;\n  color: #fff;\n  border-color: #555;\n}\n#services-list {\n  padding: 10px 12px;\n  overflow-y: auto;\n}\n.service {\n  display: flex;\n  align-items: center;\n  padding: 8px 10px;\n  margin-bottom: 4px;\n  border-radius: 6px;\n  background: rgba(255, 255, 255, 0.03);\n  border: 1px solid #2a2a35;\n  transition: border-color 0.2s;\n}\n.service:hover {\n  border-color: #444;\n}\n.status-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  margin-right: 10px;\n  flex-shrink: 0;\n}\n.running { background-color: #a6e3a1; box-shadow: 0 0 6px #a6e3a1; }\n.stopped { background-color: #f38ba8; box-shadow: 0 0 6px #f38ba8; }\n.other   { background-color: #f9e2af; box-shadow: 0 0 6px #f9e2af; }\n.name {\n  flex-grow: 1;\n  font-size: 13px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  color: #cdd6f4;\n}\n.type {\n  font-size: 10px;\n  color: #a6adc8;\n  background: #313244;\n  padding: 2px 6px;\n  border-radius: 4px;\n  flex-shrink: 0;\n  font-weight: 500;\n}\n.error-state {\n  text-align: center;\n  padding: 20px;\n  color: #f38ba8;\n  font-size: 13px;\n}\n.setup-prompt {\n  text-align: center;\n  padding: 30px 20px;\n}\n.setup-prompt .prompt-icon {\n  font-size: 36px;\n  margin-bottom: 10px;\n}\n.setup-prompt p {\n  color: #888;\n  font-size: 13px;\n  line-height: 1.5;\n}",
  "js": "const { exec } = require('child_process');\n\nlet token = null;\nlet isFetching = false;\n\nwindow.update = async function() {\n    if (isFetching) return;\n    isFetching = true;\n    \n    let sshKey = await window.widgeter.getConfig('ssh_key');\n    let vpsUser = await window.widgeter.getConfig('vps_user');\n    \n    if (!sshKey || !vpsUser) {\n        document.getElementById('services-list').innerHTML = '<div class=\"setup-prompt\"><div class=\"prompt-icon\">&#x1F511;</div><p>Setup required.<br/>Open the <strong>Widgeter Dashboard</strong> and click <strong>&#x2699; Setup</strong> to configure your SSH connection.</p></div>';\n        document.getElementById('summary').innerText = 'Not configured';\n        isFetching = false;\n        return;\n    }\n\n    if (!token) {\n        document.getElementById('summary').innerText = 'Auth...';\n        const getTokenCmd = 'ssh -i ' + sshKey + ' -o BatchMode=yes -o ConnectTimeout=5 ' + vpsUser + ' \"sudo sqlite3 -readonly /root/.survhub/survhub.db \\'select token from sessions order by created_at desc limit 1;\\'\"';\n        exec(getTokenCmd, (err, stdout, stderr) => {\n            if (err) {\n                document.getElementById('summary').innerText = 'SSH Failed';\n                document.getElementById('services-list').innerHTML = '<div class=\"error-state\">Could not connect via SSH.<br/>Check your key and host in Setup.</div>';\n                isFetching = false;\n                return;\n            }\n            token = stdout.trim();\n            if (token) fetchServices(sshKey, vpsUser);\n            else {\n                document.getElementById('summary').innerText = 'No token';\n                isFetching = false;\n            }\n        });\n    } else {\n        fetchServices(sshKey, vpsUser);\n    }\n};\n\nfunction fetchServices(sshKey, vpsUser) {\n    document.getElementById('summary').innerText = 'Refreshing...';\n    const fetchCmd = 'ssh -i ' + sshKey + ' -o BatchMode=yes -o ConnectTimeout=5 ' + vpsUser + ' \"curl -s -H \\'authorization: Bearer ' + token + '\\' http://localhost:8787/services\"';\n    exec(fetchCmd, (err, stdout, stderr) => {\n        isFetching = false;\n        if (err) {\n            token = null;\n            document.getElementById('summary').innerText = 'Error';\n            document.getElementById('services-list').innerHTML = '<div class=\"error-state\">Failed to fetch services.</div>';\n            return;\n        }\n        try {\n            const data = JSON.parse(stdout);\n            if (Array.isArray(data)) {\n                render(data);\n            } else if (data.error) {\n                document.getElementById('summary').innerText = 'Auth expired';\n                token = null;\n            }\n        } catch(e) {\n            document.getElementById('summary').innerText = 'Parse error';\n            token = null;\n        }\n    });\n}\n\nfunction render(services) {\n    const running = services.filter(s => s.status === 'running').length;\n    const summaryEl = document.getElementById('summary');\n    summaryEl.innerText = running + ' / ' + services.length;\n    summaryEl.style.background = running === services.length ? 'rgba(166,227,161,0.2)' : 'rgba(243,139,168,0.2)';\n    summaryEl.style.color = running === services.length ? '#a6e3a1' : '#f38ba8';\n\n    // wb-led-ladder: show health ratio as LED segments\n    const existingLED = document.getElementById('led-health');\n    if (!existingLED) {\n      const ledWrap = document.createElement('div');\n      ledWrap.id = 'led-health';\n      ledWrap.className = 'led-ladder-wrap';\n      ledWrap.style.marginLeft = '8px';\n      const totalSegs = 8;\n      const LEDColors = ['red','red','yellow','yellow','green','green','green','green'];\n      for (let i = 0; i < totalSegs; i++) {\n        const seg = document.createElement('div');\n        seg.className = 'led-seg ' + LEDColors[i];\n        seg.dataset.idx = i;\n        ledWrap.appendChild(seg);\n      }\n      summaryEl.parentElement.insertBefore(ledWrap, summaryEl.nextSibling);\n    }\n    const ledEl = document.getElementById('led-health');\n    if (ledEl) {\n      const ratio = running / Math.max(services.length, 1);\n      const lit = Math.round(ratio * 8);\n      const segs = ledEl.querySelectorAll('.led-seg');\n      segs.forEach((seg, i) => {\n        seg.classList.toggle('active', i < lit);\n      });\n    }\n    \n    let html = '';\n    services.sort((a,b) => a.name.localeCompare(b.name)).forEach(s => {\n        let dotClass = 'other';\n        if (s.status === 'running') dotClass = 'running';\n        if (s.status === 'stopped' || s.status === 'failed') dotClass = 'stopped';\n        \n        html += '<div class=\"service\"><div class=\"status-dot ' + dotClass + '\"></div><div class=\"name\">' + s.name + '</div><div class=\"type\">' + s.type + '</div></div>';\n    });\n    \n    document.getElementById('services-list').innerHTML = html;\n}\n\nupdate();\nsetInterval(update, 15000);",
  "setupHtml": "\n<h4>🖥️ ServerHoster Connection</h4>\n<p class=\"setup-description\">Configure the SSH connection to your VPS running ServerHoster / LocalSURV.</p>\n<div class=\"form-group\">\n    <label>SSH Private Key Path</label>\n    <input type=\"text\" class=\"setup-ssh-key\" placeholder=\"C:/Users/you/.ssh/id_rsa\" />\n    <div class=\"hint\">The local path to your SSH private key file.</div>\n</div>\n<div class=\"form-group\">\n    <label>VPS User &amp; Host</label>\n    <input type=\"text\" class=\"setup-vps-user\" placeholder=\"user@1.2.3.4\" />\n    <div class=\"hint\">SSH user and IP/hostname of your server.</div>\n</div>\n<div class=\"setup-result\"></div>\n<div class=\"setup-actions\">\n    <button class=\"btn btn-save\">💾 Save</button>\n    <button class=\"btn btn-test\" style=\"background-color: #89b4fa;\">🔌 Test Connection</button>\n</div>",
  "setupJs": "\nconst panel = document.getElementById('setup-' + widget.id);\nconst keyInput = panel.querySelector('.setup-ssh-key');\nconst userInput = panel.querySelector('.setup-vps-user');\nconst resultEl = panel.querySelector('.setup-result');\nconst saveBtn = panel.querySelector('.btn-save');\nconst testBtn = panel.querySelector('.btn-test');\n\nkeyInput.value = widget.config?.ssh_key || '';\nuserInput.value = widget.config?.vps_user || '';\n\nsaveBtn.onclick = () => {\n    const key = keyInput.value.trim();\n    const user = userInput.value.trim();\n    if (!key || !user) { alert('Both fields are required.'); return; }\n    const newConfig = { ...(widget.config || {}), ssh_key: key, vps_user: user };\n    ipcRenderer.send('update-widget-config', widget.id, newConfig);\n    resultEl.className = 'test-result success';\n    resultEl.innerText = '✓ Saved! The widget will reload automatically.';\n};\n\ntestBtn.onclick = () => {\n    const key = keyInput.value.trim();\n    const user = userInput.value.trim();\n    if (!key || !user) { alert('Fill in both fields first.'); return; }\n    resultEl.className = '';\n    resultEl.innerText = 'Testing SSH connection...';\n    const { exec } = require('child_process');\n    exec('ssh -i ' + key + ' -o BatchMode=yes -o ConnectTimeout=5 ' + user + ' \"echo OK\"', (err, stdout) => {\n        if (err || stdout.trim() !== 'OK') {\n            resultEl.className = 'test-result error';\n            resultEl.innerText = '✗ Connection failed. Check your key path and host.';\n        } else {\n            resultEl.className = 'test-result success';\n            resultEl.innerText = '✓ Connected successfully!';\n        }\n    });\n};\n"
}