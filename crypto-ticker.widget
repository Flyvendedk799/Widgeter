{
  "name": "Crypto Live Ticker",
  "width": 300,
  "height": 320,
  "html": "<div class='container'><div class='header'><div class='header-left'><span class='icon'>₿</span><div><h3>Crypto Live Ticker</h3><span class='sub'>BTC/USD Real-Time Feed</span></div></div><div class='header-right'><span id='btc-pill' class='price-pill tick-up'>+0.12%</span></div></div><div class='price-block wb-kpi-card'><span id='btc-price' class='kpi-price'>$68,420.50</span><div class='price-meta'><span id='btc-vol'>Vol: 28.4B</span><span id='btc-mcap'>MCap: 1.34T</span></div></div><div class='canvas-wrap'><canvas id='btc-canvas'></canvas></div><div class='order-book'><div id='ob-bids' class='ob-side'></div><div class='ob-divider'><span id='spread-val' class='spread'>Spread: $0.50</span></div><div id='ob-asks' class='ob-side'></div></div><div class='footer-row'><div class='wb-streak-dots' id='streak-dots'></div><div id='market-status' class='market-status'>● MARKET OPEN</div></div></div>",
  "css": "* { box-sizing: border-box; margin: 0; padding: 0; }\nbody { font-family: 'Segoe UI', sans-serif; background: transparent; color: #f0f2fb; }\n.container {\n  background: rgba(10, 12, 20, 0.92);\n  border: 1px solid rgba(255,255,255,0.08);\n  border-radius: 16px;\n  padding: 14px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.header { display: flex; justify-content: space-between; align-items: flex-start; }\n.header-left { display: flex; align-items: center; gap: 8px; }\n.icon { font-size: 22px; }\nh3 { font-size: 13px; font-weight: 700; color: #fff; margin: 0; }\n.sub { font-size: 10px; color: #9aa1b8; }\n.price-pill {\n  font-size: 11px;\n  font-weight: 700;\n  padding: 4px 10px;\n  border-radius: 999px;\n  font-family: monospace;\n  transition: all 0.3s;\n}\n.tick-up { background: rgba(6,214,160,0.15); color: #06d6a0; border: 1px solid rgba(6,214,160,0.3); }\n.tick-down { background: rgba(239,35,60,0.15); color: #ef233c; border: 1px solid rgba(239,35,60,0.3); }\n@keyframes flash-up { 0%,100% { background: rgba(6,214,160,0.15); } 50% { background: rgba(6,214,160,0.35); } }\n@keyframes flash-down { 0%,100% { background: rgba(239,35,60,0.15); } 50% { background: rgba(239,35,60,0.35); } }\n.flash-up { animation: flash-up 0.4s ease; }\n.flash-down { animation: flash-down 0.4s ease; }\n/* wb-kpi-card */\n.wb-kpi-card {\n  background: rgba(255,255,255,0.04);\n  border: 1px solid rgba(255,255,255,0.08);\n  border-radius: 10px;\n  padding: 10px 12px;\n}\n.kpi-price {\n  display: block;\n  font-size: 24px;\n  font-weight: 800;\n  font-family: 'Courier New', monospace;\n  color: #fff;\n  letter-spacing: -0.5px;\n}\n.price-meta { display: flex; gap: 12px; margin-top: 4px; }\n.price-meta span { font-size: 10px; color: #9aa1b8; font-family: monospace; }\n.canvas-wrap { }\n#btc-canvas { width: 100%; height: 70px; display: block; }\n.order-book { display: flex; flex-direction: column; gap: 3px; }\n.ob-side { display: flex; flex-direction: column; gap: 2px; }\n.ob-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 10px;\n  font-family: monospace;\n  position: relative;\n  padding: 2px 4px;\n  border-radius: 3px;\n  overflow: hidden;\n}\n.ob-bar {\n  position: absolute;\n  top: 0; bottom: 0; left: 0;\n  border-radius: 3px;\n  opacity: 0.18;\n}\n.ob-divider { text-align: center; padding: 2px 0; }\n.spread { font-size: 10px; color: #9aa1b8; font-family: monospace; }\n.footer-row { display: flex; justify-content: space-between; align-items: center; }\n/* wb-streak-dots: 7-day GitHub-style heatmap */\n.wb-streak-dots { display: flex; gap: 3px; align-items: center; }\n.streak-dot { width: 10px; height: 10px; border-radius: 2px; }\n.market-status { font-size: 9px; font-weight: 700; color: #06d6a0; letter-spacing: 0.5px; }",
  "js": "const canvas = document.getElementById('btc-canvas');\nconst priceEl = document.getElementById('btc-price');\nconst pillEl = document.getElementById('btc-pill');\nconst volEl = document.getElementById('btc-vol');\nconst bidsEl = document.getElementById('ob-bids');\nconst asksEl = document.getElementById('ob-asks');\nconst spreadEl = document.getElementById('spread-val');\nconst streakEl = document.getElementById('streak-dots');\n\n// Build wb-streak-dots (7-day activity heatmap)\nconst STREAK_LEVELS = [\n  { level: 4, color: '#06d6a0' },\n  { level: 3, color: '#3a86ff' },\n  { level: 2, color: '#8338ec' },\n  { level: 1, color: 'rgba(255,255,255,0.2)' },\n  { level: 2, color: '#3a86ff' },\n  { level: 4, color: '#06d6a0' },\n  { level: 3, color: '#ffbe0b' }\n];\nSTREAK_LEVELS.forEach(s => {\n  const dot = document.createElement('div');\n  dot.className = 'streak-dot';\n  dot.style.background = s.color;\n  dot.style.opacity = 0.3 + s.level * 0.175;\n  streakEl.appendChild(dot);\n});\n\n// Canvas sparkline\nconst ctx = canvas.getContext('2d');\ncanvas.width = canvas.parentElement.clientWidth;\ncanvas.height = 70;\nlet w = canvas.width, h = canvas.height;\nlet currentPrice = 68420.50;\nconst history = new Array(40).fill(currentPrice);\nlet prevPrice = currentPrice;\n\nfunction renderOrderBook() {\n  bidsEl.innerHTML = '';\n  asksEl.innerHTML = '';\n  for (let i = 0; i < 3; i++) {\n    const bPrice = (currentPrice - i * 0.5 - Math.random() * 0.3).toFixed(2);\n    const bAmt = (0.8 + Math.random() * 4).toFixed(4);\n    const bPct = Math.round(20 + Math.random() * 80);\n    bidsEl.innerHTML += `<div class='ob-row'><div class='ob-bar' style='width:${bPct}%;background:#06d6a0'></div><span style='color:#06d6a0;z-index:1'>${bPrice}</span><span style='color:#9aa1b8;z-index:1;margin-left:auto'>${bAmt} BTC</span></div>`;\n\n    const aPrice = (currentPrice + (i+1) * 0.5 + Math.random() * 0.3).toFixed(2);\n    const aAmt = (0.8 + Math.random() * 4).toFixed(4);\n    const aPct = Math.round(20 + Math.random() * 80);\n    asksEl.innerHTML += `<div class='ob-row'><div class='ob-bar' style='width:${aPct}%;background:#ef233c'></div><span style='color:#ef233c;z-index:1'>${aPrice}</span><span style='color:#9aa1b8;z-index:1;margin-left:auto'>${aAmt} BTC</span></div>`;\n  }\n  if (spreadEl) spreadEl.textContent = 'Spread: $' + (0.3 + Math.random() * 1.2).toFixed(2);\n}\n\nsetInterval(() => {\n  const delta = (Math.random() - 0.48) * 120;\n  prevPrice = currentPrice;\n  currentPrice += delta;\n  const pct = ((currentPrice - 68420.50) / 68420.50 * 100).toFixed(2);\n  if (priceEl) priceEl.textContent = '$' + currentPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n\n  if (pillEl) {\n    pillEl.textContent = (delta >= 0 ? '+' : '') + (delta / 68420.50 * 100).toFixed(3) + '%';\n    pillEl.className = 'price-pill ' + (delta >= 0 ? 'tick-up flash-up' : 'tick-down flash-down');\n    setTimeout(() => { pillEl.classList.remove('flash-up','flash-down'); }, 400);\n  }\n\n  if (volEl) volEl.textContent = 'Vol: ' + (26 + Math.random() * 6).toFixed(1) + 'B';\n\n  history.shift();\n  history.push(currentPrice);\n  renderOrderBook();\n}, 1800);\n\nfunction draw() {\n  ctx.clearRect(0, 0, w, h);\n  const min = Math.min(...history);\n  const max = Math.max(...history);\n  const range = (max - min) || 1;\n\n  const isUp = currentPrice >= prevPrice;\n  const lineColor = isUp ? '#06d6a0' : '#ef233c';\n\n  ctx.beginPath();\n  ctx.strokeStyle = lineColor;\n  ctx.lineWidth = 2;\n  const dx = w / (history.length - 1);\n  history.forEach((val, i) => {\n    const y = h - ((val - min) / range) * (h - 10) - 5;\n    if (i === 0) ctx.moveTo(0, y); else ctx.lineTo(i * dx, y);\n  });\n  ctx.stroke();\n\n  // gradient fill\n  ctx.lineTo(w, h); ctx.lineTo(0, h);\n  const grad = ctx.createLinearGradient(0, 0, 0, h);\n  grad.addColorStop(0, isUp ? 'rgba(6,214,160,0.2)' : 'rgba(239,35,60,0.2)');\n  grad.addColorStop(1, 'rgba(0,0,0,0)');\n  ctx.fillStyle = grad;\n  ctx.fill();\n\n  requestAnimationFrame(draw);\n}\nrenderOrderBook();\ndraw();"
}
