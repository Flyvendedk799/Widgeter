{
  "name": "NPM Outdated",
  "width": 290,
  "height": 320,
  "html": "<div class='wrap'>\n    <div class='wh'>\n      <div class='whl'><span class='wi'>📦</span><div><div class='wt'>NPM Outdated</div><div class='ws' id='npm-dir'>Configure in Setup</div></div></div>\n      <button class='btn btn-sm no-drag' onclick='npmCheck()'>Check</button>\n    </div>\n    <div id='npm'><div class='empty'>⚙ Configure project directory in Setup</div></div>\n  </div>",
  "css": "* { box-sizing: border-box; margin: 0; padding: 0; }\nbody { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background: rgba(11,13,22,0.95); color: #f0f2fb; border-radius: 14px; border: 1px solid rgba(255,255,255,0.09); overflow: hidden; }\nbody::-webkit-scrollbar { width: 4px; } body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.13); border-radius: 4px; }\n.wrap { padding: 14px; }\n/* Header */\n.wh { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n.whl { display: flex; align-items: center; gap: 8px; }\n.wi { font-size: 18px; line-height: 1; }\n.wt { font-size: 13px; font-weight: 700; color: #fff; margin: 0; }\n.ws { font-size: 10px; color: #9aa1b8; margin-top: 1px; }\n/* Cards */\n.card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; }\n.card:last-child { margin-bottom: 0; }\n/* Rows */\n.row { display: flex; justify-content: space-between; align-items: center; font-size: 11px; margin-bottom: 5px; }\n.row:last-child { margin-bottom: 0; }\n.lbl { color: #9aa1b8; }\n.val { color: #fff; font-weight: 600; font-family: 'Courier New', monospace; font-size: 11px; }\n.val-g { color: #06d6a0; font-weight: 700; font-family: monospace; }\n.val-r { color: #ef233c; font-weight: 700; font-family: monospace; }\n.val-y { color: #ffbe0b; font-weight: 700; font-family: monospace; }\n/* Progress bars */\n.pbar { background: rgba(255,255,255,0.06); border-radius: 4px; height: 5px; overflow: hidden; margin-top: 5px; }\n.pfill { height: 100%; border-radius: 4px; transition: width 0.7s ease; min-width: 2px; }\n.p-c { background: linear-gradient(90deg,#00f5d4,#3a86ff); }\n.p-g { background: linear-gradient(90deg,#06d6a0,#00f5d4); }\n.p-r { background: linear-gradient(90deg,#ef233c,#fb5607); }\n.p-o { background: linear-gradient(90deg,#fb5607,#ffbe0b); }\n.p-p { background: linear-gradient(90deg,#8338ec,#3a86ff); }\n/* Badges */\n.badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 700; padding: 3px 9px; border-radius: 999px; font-family: monospace; letter-spacing: 0.3px; }\n.b-c { background: rgba(0,245,212,0.1); color: #00f5d4; border: 1px solid rgba(0,245,212,0.25); }\n.b-g { background: rgba(6,214,160,0.1); color: #06d6a0; border: 1px solid rgba(6,214,160,0.25); }\n.b-r { background: rgba(239,35,60,0.1); color: #ef233c; border: 1px solid rgba(239,35,60,0.25); }\n.b-y { background: rgba(255,190,11,0.1); color: #ffbe0b; border: 1px solid rgba(255,190,11,0.25); }\n.b-p { background: rgba(131,56,236,0.1); color: #8338ec; border: 1px solid rgba(131,56,236,0.25); }\n/* ── wb-shimmer ── */\n@keyframes shimmer { 0% { background-position:-400px 0; } 100% { background-position:400px 0; } }\n.shimmer { height: 13px; border-radius: 4px; background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.10) 50%, rgba(255,255,255,0.04) 75%); background-size: 400px 100%; animation: shimmer 1.4s infinite linear; margin-bottom: 7px; }\n/* ── wb-radar-beacon ── */\n@keyframes radar-out { 0% { transform:scale(1); opacity:0.8; } 100% { transform:scale(3.5); opacity:0; } }\n.rdot { display:inline-block; width:7px; height:7px; border-radius:50%; position:relative; vertical-align:middle; margin-right:2px; }\n.rdot::after { content:''; position:absolute; inset:0; border-radius:50%; animation:radar-out 1.8s ease-out infinite; }\n.rd-c { background:#00f5d4; } .rd-c::after { background:#00f5d4; }\n.rd-g { background:#06d6a0; } .rd-g::after { background:#06d6a0; }\n.rd-r { background:#ef233c; } .rd-r::after { background:#ef233c; }\n.rd-y { background:#ffbe0b; } .rd-y::after { background:#ffbe0b; }\n/* ── wb-pulse-glow ── */\n@keyframes pglow { 0%,100% { box-shadow:0 0 0 0 rgba(0,245,212,0.55); } 50% { box-shadow:0 0 0 7px rgba(0,245,212,0); } }\n.pglow { animation: pglow 2.2s ease-in-out infinite; }\n/* ── wb-float ── */\n@keyframes wfloat { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-4px); } }\n.wfloat { animation: wfloat 4s ease-in-out infinite; }\n/* ── wb-conic-border ── */\n@keyframes cspin { to { transform:rotate(360deg); } }\n.cborder { position:relative; }\n.cborder::before { content:''; position:absolute; inset:-1.5px; border-radius:15px; background:conic-gradient(from 0deg,#00f5d4,#3a86ff,#8338ec,#ff006e,#ffbe0b,#00f5d4); animation:cspin 4s linear infinite; z-index:-1; }\n/* Buttons */\n.btn { background:none; border:1px solid rgba(255,255,255,0.14); color:#9aa1b8; font-size:12px; padding:4px 10px; border-radius:6px; cursor:pointer; transition:all 0.2s; font-family:inherit; }\n.btn:hover { background:rgba(255,255,255,0.08); color:#fff; border-color:rgba(255,255,255,0.3); }\n.btn-sm { padding:2px 7px; font-size:11px; }\n.btn-g { border-color:rgba(6,214,160,0.3); color:#06d6a0; }\n.btn-g:hover { background:rgba(6,214,160,0.12); }\n.btn-r { border-color:rgba(239,35,60,0.3); color:#ef233c; }\n.btn-r:hover { background:rgba(239,35,60,0.12); }\n.btn-c { border-color:rgba(0,245,212,0.3); color:#00f5d4; }\n.btn-c:hover { background:rgba(0,245,212,0.12); }\n/* Input */\n.inp { background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:#fff; padding:6px 10px; border-radius:7px; font-size:12px; width:100%; font-family:inherit; }\n.inp:focus { outline:none; border-color:rgba(0,245,212,0.4); }\n/* Empty & error */\n.empty { text-align:center; padding:24px; color:#5c6278; font-size:12px; line-height:1.5; }\n.err { color:#ef233c; font-size:11px; padding:8px 0; }\n/* Setup panel */\n.setup-desc { color:#9aa1b8; font-size:12px; margin-bottom:14px; line-height:1.5; }\n.form-group { margin-bottom:12px; }\n.form-group label { display:block; font-size:11px; color:#9aa1b8; margin-bottom:5px; }\n.setup-result { font-size:12px; margin-top:10px; min-height:16px; }\n.setup-result.ok { color:#06d6a0; }\n.setup-result.fail { color:#ef233c; }\n.setup-actions { display:flex; gap:8px; margin-top:12px; }\n.npm-row { display:flex; align-items:center; gap:6px; padding:7px 10px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:7px; margin-bottom:5px; font-size:11px; }\n   .npm-name { flex:1; color:#fff; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n   .npm-cur { color:#9aa1b8; font-family:monospace; }\n   .npm-latest { color:#06d6a0; font-family:monospace; font-weight:700; }\n   .npm-type { font-size:9px; padding:1px 5px; border-radius:3px; }\n   .t-major { background:rgba(239,35,60,0.15); color:#ef233c; }\n   .t-minor { background:rgba(255,190,11,0.15); color:#ffbe0b; }\n   .t-patch { background:rgba(6,214,160,0.15); color:#06d6a0; }",
  "js": "var exec = require('child_process').exec;\n    var projectDir = null;\n    async function init() {\n      projectDir = await window.widgeter.getConfig('npm_dir');\n      if (projectDir) { document.getElementById('npm-dir').textContent = projectDir.split('\\\\').pop()||projectDir; npmCheck(); }\n    }\n    window.npmCheck = function() {\n      if (!projectDir) return;\n      document.getElementById('npm').innerHTML = '<div class=\"shimmer\"></div><div class=\"shimmer\" style=\"width:85%\"></div><div class=\"shimmer\" style=\"width:70%\"></div>';\n      exec('npm outdated --json', {cwd:projectDir,timeout:30000}, function(err, out) {\n        var text = out || (err && err.stdout) || '';\n        if (!text.trim()) { document.getElementById('npm').innerHTML='<div class=\"empty\">✅ All packages up to date!</div>'; return; }\n        try {\n          var data = JSON.parse(text);\n          var pkgs = Object.keys(data);\n          if (!pkgs.length) { document.getElementById('npm').innerHTML='<div class=\"empty\">✅ All packages up to date!</div>'; return; }\n          var html='<div style=\"font-size:11px;color:#9aa1b8;margin-bottom:8px\">'+pkgs.length+' outdated package'+(pkgs.length!==1?'s':'')+'</div>';\n          pkgs.slice(0,12).forEach(function(name) {\n            var p=data[name];\n            var cur=(p.current||'?'), want=(p.wanted||'?'), latest=(p.latest||'?');\n            var curParts=cur.split('.'), latParts=latest.split('.');\n            var type='patch'; if(curParts[0]!==latParts[0]) type='major'; else if(curParts[1]!==latParts[1]) type='minor';\n            html+='<div class=\"npm-row\"><span class=\"npm-name\" title=\"'+name+'\">'+name+'</span><span class=\"npm-cur\">'+cur+'</span><span style=\"color:#5c6278\">→</span><span class=\"npm-latest\">'+latest+'</span><span class=\"npm-type t-'+type+'\">'+type+'</span></div>';\n          });\n          document.getElementById('npm').innerHTML = html;\n        } catch(e){ document.getElementById('npm').innerHTML='<div class=\"err\">Parse error: '+e.message+'</div>'; }\n      });\n    };\n    init();",
  "setupHtml": "<h4>📦 NPM Outdated Setup</h4>\n   <p class='setup-desc'>Enter the path to your Node.js project directory containing package.json.</p>\n   <div class='form-group'><label>Project Directory Path</label><input type='text' class='inp npm-dir' placeholder='C:\\Users\\you\\my-project'></div>\n   <div class='setup-result' id='npm-result'></div>\n   <div class='setup-actions'><button class='btn btn-g'>💾 Save</button></div>",
  "setupJs": "var p=document.getElementById('setup-'+widget.id),d=p.querySelector('.npm-dir'),r=p.querySelector('#npm-result');\n   d.value=widget.config&&widget.config.npm_dir||'';\n   p.querySelector('.btn-g').onclick=function(){ var cfg=Object.assign({},widget.config||{},{npm_dir:d.value.trim()}); ipcRenderer.send('update-widget-config',widget.id,cfg); r.className='setup-result ok'; r.textContent='✓ Saved!'; };"
}