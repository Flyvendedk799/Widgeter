{
  "name": "24-Band Audio Spectrum",
  "width": 300,
  "height": 240,
  "html": "<div class='container wb-scanlines'><div class='header'><div class='header-left'><span class='icon'>🎵</span><div><h3>Audio Spectrum</h3><span class='sub'>24-Band FFT Equalizer</span></div></div><div class='header-right'><div class='wb-led-ladder' id='vu-meter'></div></div></div><div class='spec-wrap'><div id='spec-bars'></div></div><div class='footer-row'><div class='f-box'><span id='peak-freq' class='f-val'>440 Hz</span><span class='f-lbl'>Peak Freq</span></div><div class='f-box'><span id='rms-db' class='f-val'>-12 dB</span><span class='f-lbl'>RMS Level</span></div><div class='f-box'><span id='bpm-val' class='f-val'>128 BPM</span><span class='f-lbl'>Tempo</span></div></div></div>",
  "css": "* { box-sizing: border-box; margin: 0; padding: 0; }\nbody { font-family: 'Segoe UI', sans-serif; background: transparent; color: #f0f2fb; }\n.container {\n  background: rgba(10, 12, 20, 0.92);\n  border: 1px solid rgba(255,255,255,0.08);\n  border-radius: 16px;\n  padding: 14px;\n  position: relative;\n  overflow: hidden;\n}\n/* wb-scanlines: CRT retro phosphor scanline overlay */\n.wb-scanlines::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: repeating-linear-gradient(to bottom, transparent 0px, transparent 3px, rgba(0,0,0,0.18) 3px, rgba(0,0,0,0.18) 4px);\n  pointer-events: none;\n  z-index: 9;\n  border-radius: 16px;\n}\n/* wb-led-ladder: 10-segment LED bar */\n.wb-led-ladder { display: flex; flex-direction: column; gap: 2px; }\n.led-seg { width: 8px; height: 4px; border-radius: 1px; opacity: 0.25; transition: opacity 0.12s; }\n.led-seg.active { opacity: 1; }\n.led-seg.green { background: #06d6a0; }\n.led-seg.yellow { background: #ffbe0b; }\n.led-seg.red { background: #ef233c; }\n\n.header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }\n.header-left { display: flex; align-items: center; gap: 8px; }\n.icon { font-size: 18px; }\nh3 { font-size: 13px; font-weight: 700; color: #fff; margin: 0; }\n.sub { font-size: 10px; color: #9aa1b8; }\n.spec-wrap { margin-bottom: 12px; }\n#spec-bars {\n  display: flex;\n  align-items: flex-end;\n  gap: 3px;\n  height: 100px;\n  padding: 0 2px;\n}\n.spec-bar {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  position: relative;\n  border-radius: 3px 3px 0 0;\n  min-height: 4px;\n  transition: height 0.05s ease;\n}\n.bar-fill {\n  border-radius: 3px 3px 0 0;\n  background: linear-gradient(to top, #3a86ff, #00f5d4);\n  transition: height 0.08s ease;\n  min-height: 4px;\n}\n.bar-peak {\n  position: absolute;\n  top: -3px;\n  left: 0; right: 0;\n  height: 2px;\n  background: #00f5d4;\n  border-radius: 2px;\n}\n.footer-row { display: flex; gap: 6px; }\n.f-box { flex: 1; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; padding: 6px 4px; text-align: center; }\n.f-val { display: block; font-size: 11px; font-weight: 700; color: #00f5d4; font-family: monospace; }\n.f-lbl { display: block; font-size: 9px; color: #5c6278; margin-top: 2px; }",
  "js": "const specContainer = document.getElementById('spec-bars');\nconst vuMeter = document.getElementById('vu-meter');\nconst peakFreqEl = document.getElementById('peak-freq');\nconst rmsEl = document.getElementById('rms-db');\nconst bpmEl = document.getElementById('bpm-val');\n\n// Build LED ladder (10 segments: 5 green, 3 yellow, 2 red)\nvuMeter.innerHTML = '';\nconst ledColors = ['red','red','yellow','yellow','yellow','green','green','green','green','green'];\nconst ledSegs = ledColors.map(color => {\n  const seg = document.createElement('div');\n  seg.className = 'led-seg ' + color;\n  vuMeter.appendChild(seg);\n  return seg;\n});\n\n// Build 24 spectrum bars\nspecContainer.innerHTML = '';\nconst bars = [];\nfor (let i = 0; i < 24; i++) {\n  const wrapper = document.createElement('div');\n  wrapper.style.cssText = 'flex:1; position:relative; height:100%; display:flex; flex-direction:column; justify-content:flex-end;';\n  const fill = document.createElement('div');\n  fill.className = 'bar-fill';\n  fill.style.height = '20%';\n  const peak = document.createElement('div');\n  peak.className = 'bar-peak';\n  wrapper.appendChild(fill);\n  wrapper.appendChild(peak);\n  specContainer.appendChild(wrapper);\n  bars.push({ fill, peak, h: 20, pk: 20 });\n}\n\n// Freq display\nconst FREQS = ['20Hz','32','50','80','125','160','200','250','315','400','500','630','800','1k','1.25k','1.6k','2k','2.5k','3.15k','4k','5k','6.3k','8k','16k'];\nconst BPMS = ['90 BPM','110 BPM','128 BPM','140 BPM','160 BPM'];\nlet bpmIdx = 2;\nsetInterval(() => { if (bpmEl) { bpmIdx = (bpmIdx + (Math.random() < 0.1 ? 1 : 0)) % BPMS.length; bpmEl.textContent = BPMS[bpmIdx]; } }, 8000);\n\nfunction tick() {\n  let maxH = 0;\n  bars.forEach((b, i) => {\n    const harmonic = Math.sin(Date.now() * 0.005 + i * 0.3) * 30 + 50;\n    const noise = Math.random() * 20;\n    const target = Math.max(6, Math.min(100, harmonic + noise));\n    b.h = target;\n    b.fill.style.height = b.h + '%';\n    if (b.h > b.pk) b.pk = b.h;\n    else b.pk = Math.max(b.h, b.pk - 1.5);\n    b.peak.style.top = -(b.pk - b.h) * 0.9 + 'px';\n    if (b.h > maxH) maxH = b.h;\n  });\n\n  // LED meter\n  const ledLevel = Math.round((maxH / 100) * 10);\n  ledSegs.forEach((seg, i) => {\n    seg.classList.toggle('active', i >= (10 - ledLevel));\n  });\n\n  // RMS dB simulation\n  if (rmsEl) rmsEl.textContent = (-24 + Math.round(maxH * 0.18)) + ' dB';\n  if (peakFreqEl && Math.random() < 0.1) {\n    const peakIdx = bars.reduce((mi, b, i) => b.h > bars[mi].h ? i : mi, 0);\n    peakFreqEl.textContent = FREQS[peakIdx] || '440 Hz';\n  }\n\n  requestAnimationFrame(tick);\n}\ntick();"
}
