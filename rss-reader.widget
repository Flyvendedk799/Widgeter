{
  "name": "RSS Reader",
  "width": 300,
  "height": 360,
  "html": "<div class='wrap'>\n    <div class='wh'>\n      <div class='whl'><span class='wi'>📰</span><div><div class='wt'>RSS Reader</div><div class='ws' id='rss-src'>Configure feed in Setup</div></div></div>\n      <button class='btn btn-sm no-drag' onclick='rssFetch()'>⟳</button>\n    </div>\n    <div id='rss'><div class='empty'>⚙ Configure a feed URL in Setup</div></div>\n  </div>",
  "css": "* { box-sizing: border-box; margin: 0; padding: 0; }\nbody { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background: rgba(11,13,22,0.95); color: #f0f2fb; border-radius: 14px; border: 1px solid rgba(255,255,255,0.09); overflow: hidden; }\nbody::-webkit-scrollbar { width: 4px; } body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.13); border-radius: 4px; }\n.wrap { padding: 14px; }\n/* Header */\n.wh { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n.whl { display: flex; align-items: center; gap: 8px; }\n.wi { font-size: 18px; line-height: 1; }\n.wt { font-size: 13px; font-weight: 700; color: #fff; margin: 0; }\n.ws { font-size: 10px; color: #9aa1b8; margin-top: 1px; }\n/* Cards */\n.card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; }\n.card:last-child { margin-bottom: 0; }\n/* Rows */\n.row { display: flex; justify-content: space-between; align-items: center; font-size: 11px; margin-bottom: 5px; }\n.row:last-child { margin-bottom: 0; }\n.lbl { color: #9aa1b8; }\n.val { color: #fff; font-weight: 600; font-family: 'Courier New', monospace; font-size: 11px; }\n.val-g { color: #06d6a0; font-weight: 700; font-family: monospace; }\n.val-r { color: #ef233c; font-weight: 700; font-family: monospace; }\n.val-y { color: #ffbe0b; font-weight: 700; font-family: monospace; }\n/* Progress bars */\n.pbar { background: rgba(255,255,255,0.06); border-radius: 4px; height: 5px; overflow: hidden; margin-top: 5px; }\n.pfill { height: 100%; border-radius: 4px; transition: width 0.7s ease; min-width: 2px; }\n.p-c { background: linear-gradient(90deg,#00f5d4,#3a86ff); }\n.p-g { background: linear-gradient(90deg,#06d6a0,#00f5d4); }\n.p-r { background: linear-gradient(90deg,#ef233c,#fb5607); }\n.p-o { background: linear-gradient(90deg,#fb5607,#ffbe0b); }\n.p-p { background: linear-gradient(90deg,#8338ec,#3a86ff); }\n/* Badges */\n.badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 700; padding: 3px 9px; border-radius: 999px; font-family: monospace; letter-spacing: 0.3px; }\n.b-c { background: rgba(0,245,212,0.1); color: #00f5d4; border: 1px solid rgba(0,245,212,0.25); }\n.b-g { background: rgba(6,214,160,0.1); color: #06d6a0; border: 1px solid rgba(6,214,160,0.25); }\n.b-r { background: rgba(239,35,60,0.1); color: #ef233c; border: 1px solid rgba(239,35,60,0.25); }\n.b-y { background: rgba(255,190,11,0.1); color: #ffbe0b; border: 1px solid rgba(255,190,11,0.25); }\n.b-p { background: rgba(131,56,236,0.1); color: #8338ec; border: 1px solid rgba(131,56,236,0.25); }\n/* ── wb-shimmer ── */\n@keyframes shimmer { 0% { background-position:-400px 0; } 100% { background-position:400px 0; } }\n.shimmer { height: 13px; border-radius: 4px; background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.10) 50%, rgba(255,255,255,0.04) 75%); background-size: 400px 100%; animation: shimmer 1.4s infinite linear; margin-bottom: 7px; }\n/* ── wb-radar-beacon ── */\n@keyframes radar-out { 0% { transform:scale(1); opacity:0.8; } 100% { transform:scale(3.5); opacity:0; } }\n.rdot { display:inline-block; width:7px; height:7px; border-radius:50%; position:relative; vertical-align:middle; margin-right:2px; }\n.rdot::after { content:''; position:absolute; inset:0; border-radius:50%; animation:radar-out 1.8s ease-out infinite; }\n.rd-c { background:#00f5d4; } .rd-c::after { background:#00f5d4; }\n.rd-g { background:#06d6a0; } .rd-g::after { background:#06d6a0; }\n.rd-r { background:#ef233c; } .rd-r::after { background:#ef233c; }\n.rd-y { background:#ffbe0b; } .rd-y::after { background:#ffbe0b; }\n/* ── wb-pulse-glow ── */\n@keyframes pglow { 0%,100% { box-shadow:0 0 0 0 rgba(0,245,212,0.55); } 50% { box-shadow:0 0 0 7px rgba(0,245,212,0); } }\n.pglow { animation: pglow 2.2s ease-in-out infinite; }\n/* ── wb-float ── */\n@keyframes wfloat { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-4px); } }\n.wfloat { animation: wfloat 4s ease-in-out infinite; }\n/* ── wb-conic-border ── */\n@keyframes cspin { to { transform:rotate(360deg); } }\n.cborder { position:relative; }\n.cborder::before { content:''; position:absolute; inset:-1.5px; border-radius:15px; background:conic-gradient(from 0deg,#00f5d4,#3a86ff,#8338ec,#ff006e,#ffbe0b,#00f5d4); animation:cspin 4s linear infinite; z-index:-1; }\n/* Buttons */\n.btn { background:none; border:1px solid rgba(255,255,255,0.14); color:#9aa1b8; font-size:12px; padding:4px 10px; border-radius:6px; cursor:pointer; transition:all 0.2s; font-family:inherit; }\n.btn:hover { background:rgba(255,255,255,0.08); color:#fff; border-color:rgba(255,255,255,0.3); }\n.btn-sm { padding:2px 7px; font-size:11px; }\n.btn-g { border-color:rgba(6,214,160,0.3); color:#06d6a0; }\n.btn-g:hover { background:rgba(6,214,160,0.12); }\n.btn-r { border-color:rgba(239,35,60,0.3); color:#ef233c; }\n.btn-r:hover { background:rgba(239,35,60,0.12); }\n.btn-c { border-color:rgba(0,245,212,0.3); color:#00f5d4; }\n.btn-c:hover { background:rgba(0,245,212,0.12); }\n/* Input */\n.inp { background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:#fff; padding:6px 10px; border-radius:7px; font-size:12px; width:100%; font-family:inherit; }\n.inp:focus { outline:none; border-color:rgba(0,245,212,0.4); }\n/* Empty & error */\n.empty { text-align:center; padding:24px; color:#5c6278; font-size:12px; line-height:1.5; }\n.err { color:#ef233c; font-size:11px; padding:8px 0; }\n/* Setup panel */\n.setup-desc { color:#9aa1b8; font-size:12px; margin-bottom:14px; line-height:1.5; }\n.form-group { margin-bottom:12px; }\n.form-group label { display:block; font-size:11px; color:#9aa1b8; margin-bottom:5px; }\n.setup-result { font-size:12px; margin-top:10px; min-height:16px; }\n.setup-result.ok { color:#06d6a0; }\n.setup-result.fail { color:#ef233c; }\n.setup-actions { display:flex; gap:8px; margin-top:12px; }\n.rss-item { padding:9px 12px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.07); border-radius:8px; margin-bottom:6px; cursor:pointer; transition:border-color 0.2s; }\n   .rss-item:hover { border-color:rgba(0,245,212,0.4); background:rgba(0,245,212,0.04); }\n   .rss-title { font-size:12px; font-weight:600; color:#fff; line-height:1.4; margin-bottom:3px; }\n   .rss-date { font-size:10px; color:#5c6278; }",
  "js": "var https = require('https'), http = require('http'), url = require('url');\n    var shell = require('electron').shell;\n    var feedUrl = null;\n    async function init() {\n      feedUrl = await window.widgeter.getConfig('rss_url');\n      if (feedUrl) { document.getElementById('rss-src').textContent = feedUrl.split('/')[2]||feedUrl; rssFetch(); }\n    }\n    window.rssFetch = function() {\n      if (!feedUrl) return;\n      var parsed = url.parse(feedUrl);\n      var mod = parsed.protocol === 'https:' ? https : http;\n      var req = mod.request({hostname:parsed.hostname,path:parsed.path,headers:{'User-Agent':'Widgeter'}}, function(res) {\n        var d=''; res.on('data',function(c){d+=c;}); res.on('end',function(){\n          try {\n            var items=[], titleRe=/<item[^>]*>[\\s\\S]*?<title[^>]*>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?<\\/title>/g, linkRe=/<link>([^<]+)<\\/link>/g, dateRe=/<pubDate>([^<]+)<\\/pubDate>/g;\n            var t,l,dt;\n            while ((t=titleRe.exec(d)) && (l=linkRe.exec(d))) {\n              dt=dateRe.exec(d);\n              items.push({title:t[1].replace(/<[^>]+>/g,'').trim(),link:l[1].trim(),date:dt?dt[1].trim():''});\n            }\n            if (!items.length) { document.getElementById('rss').innerHTML='<div class=\"err\">Could not parse feed</div>'; return; }\n            var html='';\n            items.slice(0,6).forEach(function(item) {\n              var dateStr=''; try{ var d=new Date(item.date); dateStr=isNaN(d)?item.date.slice(0,16):d.toLocaleDateString(); }catch(e){}\n              html+='<div class=\"rss-item no-drag\" onclick=\"rssOpen(\\''+item.link.replace(/'/g,\"\\\\'\")+'\\')\">' +\n                '<div class=\"rss-title\">'+item.title+'</div>' +\n                '<div class=\"rss-date\">'+dateStr+'</div>' +\n              '</div>';\n            });\n            document.getElementById('rss').innerHTML = html;\n          } catch(e){ document.getElementById('rss').innerHTML='<div class=\"err\">'+e.message+'</div>'; }\n        });\n      });\n      req.on('error',function(e){document.getElementById('rss').innerHTML='<div class=\"err\">'+e.message+'</div>';});\n      req.setTimeout(10000,function(){req.destroy();});\n      req.end();\n    };\n    window.rssOpen = function(url) { shell.openExternal(url); };\n    init(); setInterval(function(){ if(feedUrl) rssFetch(); }, 300000);",
  "setupHtml": "<h4>📰 RSS Reader Setup</h4>\n   <p class='setup-desc'>Enter a full RSS or Atom feed URL. Examples: BBC News, Hacker News, your blog.</p>\n   <div class='form-group'><label>RSS Feed URL</label><input type='text' class='inp rss-url' placeholder='https://feeds.bbci.co.uk/news/rss.xml'></div>\n   <div class='setup-result' id='rss-result'></div>\n   <div class='setup-actions'><button class='btn btn-g'>💾 Save</button></div>",
  "setupJs": "var p=document.getElementById('setup-'+widget.id),u=p.querySelector('.rss-url'),r=p.querySelector('#rss-result');\n   u.value=widget.config&&widget.config.rss_url||'';\n   p.querySelector('.btn-g').onclick=function(){ var cfg=Object.assign({},widget.config||{},{rss_url:u.value.trim()}); ipcRenderer.send('update-widget-config',widget.id,cfg); r.className='setup-result ok'; r.textContent='✓ Saved!'; };"
}