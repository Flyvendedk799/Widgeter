{
  "name": "CPU Multi-Core Heartbeat",
  "width": 300,
  "height": 280,
  "html": "<div class='container wb-conic-border wb-float'><div class='header'><div class='header-left'><span class='w-icon'>🧠</span><div><h3>CPU Heartbeat</h3><span class='w-sub'>16-Core Live Thread Load</span></div></div><div class='header-right'><span id='cpu-pct' class='stat-badge wb-pulse-glow'>47%</span></div></div><div class='canvas-wrap'><canvas id='cpu-canvas'></canvas></div><div class='core-grid' id='core-grid'></div><div class='metrics-row'><div class='m-box'><span class='m-val' id='cpu-temp'>62°C</span><span class='m-lbl'>Package Temp</span></div><div class='m-box'><span class='m-val' id='cpu-clock'>4.82 GHz</span><span class='m-lbl'>Clock Boost</span></div><div class='m-box'><span class='m-val'>8 Cores</span><span class='m-lbl'>Active Threads</span></div></div></div>",
  "css": "* { box-sizing: border-box; margin: 0; padding: 0; }\nbody { font-family: 'Segoe UI', sans-serif; background: transparent; color: #f0f2fb; padding: 0; }\n.container {\n  background: rgba(13, 15, 24, 0.88);\n  border: 1px solid rgba(0,245,212,0.25);\n  border-radius: 16px;\n  padding: 14px;\n  position: relative;\n  overflow: hidden;\n}\n/* wb-float: smooth vertical levitation */\n@keyframes wb-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }\n.wb-float { animation: wb-float 4s ease-in-out infinite; }\n/* wb-conic-border: spinning rainbow neon border */\n@keyframes wb-spin { to { transform: rotate(360deg); } }\n.wb-conic-border::before {\n  content: '';\n  position: absolute;\n  inset: -2px;\n  border-radius: inherit;\n  background: conic-gradient(from 0deg, #00f5d4, #3a86ff, #8338ec, #ff006e, #ffbe0b, #00f5d4);\n  animation: wb-spin 3s linear infinite;\n  z-index: -1;\n  border-radius: 18px;\n}\n/* wb-pulse-glow: ambient breathing aura */\n@keyframes wb-pulse-glow { 0%,100% { box-shadow: 0 0 0 0 rgba(0,245,212,0.6); } 50% { box-shadow: 0 0 0 8px rgba(0,245,212,0); } }\n.wb-pulse-glow { animation: wb-pulse-glow 2s ease-in-out infinite; }\n\n.header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }\n.header-left { display: flex; align-items: center; gap: 8px; }\n.w-icon { font-size: 18px; }\nh3 { font-size: 13px; font-weight: 700; color: #fff; margin: 0; }\n.w-sub { font-size: 10px; color: #9aa1b8; }\n.stat-badge {\n  background: rgba(0,245,212,0.12);\n  color: #00f5d4;\n  font-size: 13px;\n  font-weight: 700;\n  padding: 4px 10px;\n  border-radius: 999px;\n  border: 1px solid rgba(0,245,212,0.3);\n  font-family: 'Courier New', monospace;\n}\n.canvas-wrap { width: 100%; margin-bottom: 8px; }\n#cpu-canvas { width: 100%; height: 70px; display: block; }\n.core-grid {\n  display: grid;\n  grid-template-columns: repeat(8, 1fr);\n  gap: 4px;\n  margin-bottom: 10px;\n  height: 50px;\n  align-items: flex-end;\n}\n.core-col { display: flex; flex-direction: column; align-items: center; gap: 2px; height: 100%; justify-content: flex-end; }\n.core-bar-track { width: 100%; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden; flex: 1; display: flex; align-items: flex-end; }\n.core-bar-fill { width: 100%; background: linear-gradient(to top, #00f5d4, #3a86ff); border-radius: 3px; transition: height 0.4s ease; min-height: 4px; }\n.core-num-tag { font-size: 8px; color: #5c6278; font-family: monospace; }\n.metrics-row { display: flex; gap: 6px; }\n.m-box { flex: 1; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; padding: 6px 8px; text-align: center; }\n.m-val { display: block; font-size: 12px; font-weight: 700; color: #00f5d4; font-family: monospace; }\n.m-lbl { display: block; font-size: 9px; color: #5c6278; margin-top: 2px; }",
  "js": "const canvas = document.getElementById('cpu-canvas');\nconst coreGrid = document.getElementById('core-grid');\nconst pctEl = document.getElementById('cpu-pct');\nconst tempEl = document.getElementById('cpu-temp');\nconst clockEl = document.getElementById('cpu-clock');\nif (!canvas || !coreGrid) return;\n\nconst ctx = canvas.getContext('2d');\ncanvas.width = canvas.parentElement.clientWidth;\ncanvas.height = 70;\nlet w = canvas.width, h = canvas.height;\n\n// Build 8 core bars\ncoreGrid.innerHTML = '';\nconst coreBars = [];\nfor (let i = 1; i <= 8; i++) {\n  const col = document.createElement('div');\n  col.className = 'core-col';\n  col.innerHTML = `<div class='core-bar-track'><div class='core-bar-fill' style='height:${30+Math.random()*40}%'></div></div><span class='core-num-tag'>C${i}</span>`;\n  coreGrid.appendChild(col);\n  coreBars.push(col.querySelector('.core-bar-fill'));\n}\n\nconst history = new Array(60).fill(40);\nlet step = 0;\n\nfunction render() {\n  step += 0.05;\n  const load = 40 + Math.sin(step) * 25 + Math.random() * 8;\n  history.shift();\n  history.push(load);\n  if (pctEl && Math.random() < 0.1) pctEl.textContent = Math.round(load) + '%';\n  if (Math.random() < 0.05 && tempEl) tempEl.textContent = Math.round(58 + load * 0.1) + '°C';\n  if (Math.random() < 0.04 && clockEl) clockEl.textContent = (4.5 + Math.random() * 0.6).toFixed(2) + ' GHz';\n  if (Math.random() < 0.15) {\n    coreBars.forEach(bar => {\n      bar.style.height = Math.min(98, Math.max(15, load + (Math.random()*30-15))) + '%';\n    });\n  }\n\n  ctx.clearRect(0, 0, w, h);\n  ctx.strokeStyle = 'rgba(0,245,212,0.08)';\n  ctx.lineWidth = 1;\n  ctx.beginPath(); ctx.moveTo(0, h/2); ctx.lineTo(w, h/2); ctx.stroke();\n\n  ctx.beginPath();\n  ctx.strokeStyle = '#00f5d4';\n  ctx.lineWidth = 2.5;\n  const dx = w / (history.length - 1);\n  for (let i = 0; i < history.length; i++) {\n    const y = h - (history[i] / 100) * h;\n    if (i === 0) ctx.moveTo(0, y); else ctx.lineTo(i * dx, y);\n  }\n  ctx.stroke();\n\n  ctx.lineTo(w, h); ctx.lineTo(0, h);\n  const grad = ctx.createLinearGradient(0, 0, 0, h);\n  grad.addColorStop(0, 'rgba(0,245,212,0.22)');\n  grad.addColorStop(1, 'rgba(0,245,212,0)');\n  ctx.fillStyle = grad;\n  ctx.fill();\n\n  requestAnimationFrame(render);\n}\nrender();"
}
