{
  "name": "Git Status",
  "width": 300,
  "height": 400,
  "html": "<div class='outer-wrap wb-float'><div class='header'><h3><span class='wb-radar-beacon'></span>Git Status</h3><button id='refresh-btn'>Refresh</button></div><div id='git-content'><div class='wb-shimmer'></div><div class='wb-shimmer' style='width:70%;margin-top:8px'></div><div class='wb-shimmer' style='width:85%;margin-top:8px'></div></div></div>",
  "css": "body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: transparent; color: #fff; margin: 0; padding: 0; }\nbody::-webkit-scrollbar { width: 5px; }\nbody::-webkit-scrollbar-thumb { background-color: #555; border-radius: 5px; }\n\n/* === wb-float: smooth vertical levitation === */\n@keyframes wb-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }\n.wb-float { animation: wb-float 5s ease-in-out infinite; }\n\n/* === wb-conic-border: spinning neon border on .outer-wrap === */\n@keyframes wb-spin { to { transform: rotate(360deg); } }\n.outer-wrap {\n  background: rgba(20, 20, 25, 0.92);\n  border-radius: 12px;\n  padding: 15px;\n  position: relative;\n  overflow: hidden;\n}\n.outer-wrap::before {\n  content: '';\n  position: absolute;\n  inset: -2px;\n  border-radius: 14px;\n  background: conic-gradient(from 0deg, #f14e32, #ff9a00, #f14e32, #ff4444, #f14e32);\n  animation: wb-spin 4s linear infinite;\n  z-index: -1;\n}\n\n/* === wb-shimmer: skeleton loading sweep === */\n@keyframes wb-shimmer {\n  0% { background-position: -400px 0; }\n  100% { background-position: 400px 0; }\n}\n.wb-shimmer {\n  height: 14px;\n  border-radius: 4px;\n  background: linear-gradient(90deg, rgba(255,255,255,0.05) 25%, rgba(255,255,255,0.12) 50%, rgba(255,255,255,0.05) 75%);\n  background-size: 400px 100%;\n  animation: wb-shimmer 1.4s infinite linear;\n  margin-bottom: 6px;\n}\n\n/* === wb-radar-beacon: expanding radar pulse dot === */\n@keyframes wb-radar { 0% { transform: scale(1); opacity: 1; } 100% { transform: scale(2.8); opacity: 0; } }\n.wb-radar-beacon {\n  display: inline-block;\n  width: 8px; height: 8px;\n  border-radius: 50%;\n  background: #f14e32;\n  position: relative;\n  margin-right: 4px;\n  vertical-align: middle;\n  box-shadow: 0 0 4px #f14e32;\n}\n.wb-radar-beacon::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  background: #f14e32;\n  animation: wb-radar 1.6s ease-out infinite;\n}\n\n.header { border-bottom: 1px solid rgba(255,255,255,0.12); padding-bottom: 10px; margin-bottom: 10px; position: sticky; top: 0; background: rgba(20,20,25,0.95); z-index: 10; display: flex; flex-direction: row; justify-content: space-between; align-items: center; gap: 5px; }\nh3 { margin: 0; color: #f14e32; font-size: 16px; display: flex; align-items: center; gap: 5px; }\n#refresh-btn { background: #333; color: #fff; border: 1px solid #555; cursor: pointer; padding: 4px 8px; border-radius: 4px; font-size: 11px; transition: background 0.2s; }\n#refresh-btn:hover { background: #444; }\n.section-title { font-size: 12px; font-weight: bold; color: #aaa; margin: 10px 0 5px 0; border-bottom: 1px solid #333; padding-bottom: 2px; }\n.status-line { font-size: 12px; color: #00ffcc; margin-bottom: 10px; }\n.file-item { font-size: 11px; color: #ddd; display: flex; gap: 5px; margin-bottom: 3px; }\n.file-item.M { color: #ffaa00; }\n.file-item.A { color: #00ffcc; }\n.file-item.D { color: #ff4444; }\n.file-item.untracked { color: #888; }\n.commit-item { font-size: 11px; margin-bottom: 8px; padding-left: 8px; border-left: 2px solid #555; transition: border-color 0.3s; }\n.commit-item:hover { border-color: #f14e32; }\n.commit-hash { color: #f14e32; font-family: monospace; }\n.commit-msg { color: #ccc; }\n.error { color: #ff4444; font-size: 12px; }",
  "js": "\nconst { exec } = require('child_process');\nconst fs = require('fs');\n\nfunction runGit(cmd, cwd) {\n    return new Promise((resolve, reject) => {\n        exec(cmd, { cwd }, (err, stdout, stderr) => {\n            if (err) return reject(stderr || err.message);\n            resolve(stdout.trim());\n        });\n    });\n}\n\nasync function updateGit() {\n    const content = document.getElementById('git-content');\n    let path = await window.widgeter.getConfig('repo_path');\n    if (!path) {\n        content.innerHTML = '<div class=\"error\">Repository path not set. Please configure it in the Setup tab of the Dashboard.</div>';\n        return;\n    }\n    \n    if (!fs.existsSync(path)) {\n        content.innerHTML = '<div class=\"error\">Directory does not exist: ' + path + '</div>';\n        return;\n    }\n    \n    content.innerHTML = 'Loading...';\n    try {\n        const branch = await runGit('git rev-parse --abbrev-ref HEAD', path);\n        const status = await runGit('git status --porcelain', path);\n        const log = await runGit('git log -n 3 --pretty=format:\"%h|%s\"', path);\n        \n        let html = '<div class=\"status-line\">Branch: <b>' + branch + '</b></div>';\n        \n        html += '<div class=\"section-title\">Changes</div>';\n        if (!status) {\n            html += '<div style=\"font-size: 11px; color: #888;\">No changes. Working tree clean.</div>';\n        } else {\n            const lines = status.split('\\n');\n            for (let i = 0; i < lines.length; i++) {\n                const line = lines[i];\n                if (!line) continue;\n                const flag = line.substring(0, 2).trim();\n                const file = line.substring(3);\n                let colorClass = 'untracked';\n                if (flag.includes('M')) colorClass = 'M';\n                else if (flag.includes('A')) colorClass = 'A';\n                else if (flag.includes('D')) colorClass = 'D';\n                html += '<div class=\"file-item ' + colorClass + '\"><b>' + flag + '</b> ' + file + '</div>';\n            }\n        }\n        \n        html += '<div class=\"section-title\">Recent Commits</div>';\n        if (log) {\n            const commits = log.split('\\n');\n            for (let i = 0; i < commits.length; i++) {\n                const parts = commits[i].split('|');\n                html += '<div class=\"commit-item\"><span class=\"commit-hash\">' + parts[0] + '</span> <span class=\"commit-msg\">' + parts[1] + '</span></div>';\n            }\n        }\n        \n        content.innerHTML = html;\n    } catch (e) {\n        content.innerHTML = '<div class=\"error\">' + e + '</div>';\n    }\n}\n\ndocument.getElementById('refresh-btn').addEventListener('click', updateGit);\nupdateGit();\nsetInterval(updateGit, 60000); // refresh every minute",
  "setupHtml": "\n<h4>📦 Git Connection</h4>\n<p class=\"setup-description\">Set the path to the git repository you want to monitor.</p>\n<div class=\"form-group\">\n    <label>Repository Path</label>\n    <input type=\"text\" class=\"setup-repo-path\" placeholder=\"C:/Users/tobia/Widgeter\" />\n</div>\n<div class=\"setup-result\"></div>\n<div class=\"setup-actions\">\n    <button class=\"btn btn-save\">💾 Save</button>\n</div>",
  "setupJs": "\nconst panel = document.getElementById('setup-' + widget.id);\nconst repoPathInput = panel.querySelector('.setup-repo-path');\nconst saveBtn = panel.querySelector('.btn-save');\nconst resultEl = panel.querySelector('.setup-result');\n\nrepoPathInput.value = widget.config?.repo_path || '';\n\nsaveBtn.onclick = () => {\n    const repoPath = repoPathInput.value.trim();\n    const newConfig = { ...(widget.config || {}), repo_path: repoPath };\n    ipcRenderer.send('update-widget-config', widget.id, newConfig);\n    resultEl.className = 'test-result success';\n    resultEl.innerText = '✓ Saved! The widget will reload automatically.';\n};\n"
}