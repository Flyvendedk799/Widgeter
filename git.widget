{
  "name": "Git Status",
  "width": 300,
  "height": 400,
  "html": "<div class='header'>\n  <h3>Git Status</h3>\n  <button id='refresh-btn'>Refresh</button>\n</div>\n<div id='git-content'>Loading...</div>",
  "css": "body {\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n  background: rgba(20, 20, 25, 0.9);\n  color: #fff;\n  margin: 0;\n  padding: 15px;\n  border-radius: 12px;\n  border: 1px solid #444;\n  \n  \n}\nbody::-webkit-scrollbar { width: 5px; }\nbody::-webkit-scrollbar-thumb { background-color: #555; border-radius: 5px; }\n.header {\n  border-bottom: 1px solid #444;\n  padding-bottom: 10px;\n  margin-bottom: 10px;\n  position: sticky;\n  top: 0;\n  background: rgba(20, 20, 25, 0.95);\n  z-index: 10;\n  display: flex;\n  flex-direction: row;\n  justify-content: space-between;\n  align-items: center;\n  gap: 5px;\n}\nh3 { margin: 0; color: #f14e32; font-size: 16px; display: flex; align-items: center; gap: 5px; }\nh3::before { content: '📦'; font-size: 14px; }\n#refresh-btn {\n  background: #333;\n  color: #fff;\n  border: 1px solid #555;\n  cursor: pointer;\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-size: 11px;\n}\n#refresh-btn:hover { background: #444; }\n.section-title { font-size: 12px; font-weight: bold; color: #aaa; margin: 10px 0 5px 0; border-bottom: 1px solid #333; padding-bottom: 2px; }\n.status-line { font-size: 12px; color: #00ffcc; margin-bottom: 10px; }\n.file-item { font-size: 11px; color: #ddd; display: flex; gap: 5px; margin-bottom: 3px; }\n.file-item.M { color: #ffaa00; }\n.file-item.A { color: #00ffcc; }\n.file-item.D { color: #ff4444; }\n.file-item.untracked { color: #888; }\n.commit-item { font-size: 11px; margin-bottom: 8px; padding-left: 8px; border-left: 2px solid #555; }\n.commit-hash { color: #f14e32; font-family: monospace; }\n.commit-msg { color: #ccc; }\n.error { color: #ff4444; font-size: 12px; }",
  "js": "const { exec } = require('child_process');\nconst fs = require('fs');\n\nfunction runGit(cmd, cwd) {\n    return new Promise((resolve, reject) => {\n        exec(cmd, { cwd }, (err, stdout, stderr) => {\n            if (err) return reject(stderr || err.message);\n            resolve(stdout.trim());\n        });\n    });\n}\n\nasync function updateGit() {\n    const content = document.getElementById('git-content');\n    let path = await window.widgeter.getConfig('repo_path');\n    if (!path) {\n        content.innerHTML = '<div class=\"error\">Repository path not set. Please configure it in the Setup tab of the Dashboard.</div>';\n        return;\n    }\n    \n    if (!fs.existsSync(path)) {\n        content.innerHTML = '<div class=\"error\">Directory does not exist: ' + path + '</div>';\n        return;\n    }\n    \n    content.innerHTML = 'Loading...';\n    try {\n        const branch = await runGit('git rev-parse --abbrev-ref HEAD', path);\n        const status = await runGit('git status --porcelain', path);\n        const log = await runGit('git log -n 3 --pretty=format:\"%h|%s\"', path);\n        \n        let html = '<div class=\"status-line\">Branch: <b>' + branch + '</b></div>';\n        \n        html += '<div class=\"section-title\">Changes</div>';\n        if (!status) {\n            html += '<div style=\"font-size: 11px; color: #888;\">No changes. Working tree clean.</div>';\n        } else {\n            const lines = status.split('\\n');\n            for (let i = 0; i < lines.length; i++) {\n                const line = lines[i];\n                if (!line) continue;\n                const flag = line.substring(0, 2).trim();\n                const file = line.substring(3);\n                let colorClass = 'untracked';\n                if (flag.includes('M')) colorClass = 'M';\n                else if (flag.includes('A')) colorClass = 'A';\n                else if (flag.includes('D')) colorClass = 'D';\n                html += '<div class=\"file-item ' + colorClass + '\"><b>' + flag + '</b> ' + file + '</div>';\n            }\n        }\n        \n        html += '<div class=\"section-title\">Recent Commits</div>';\n        if (log) {\n            const commits = log.split('\\n');\n            for (let i = 0; i < commits.length; i++) {\n                const parts = commits[i].split('|');\n                html += '<div class=\"commit-item\"><span class=\"commit-hash\">' + parts[0] + '</span> <span class=\"commit-msg\">' + parts[1] + '</span></div>';\n            }\n        }\n        \n        content.innerHTML = html;\n        if (window.widgeter && window.widgeter.autoResize) { setTimeout(() => window.widgeter.autoResize(document.documentElement.scrollWidth, document.documentElement.scrollHeight), 50); }\n    } catch (e) {\n        content.innerHTML = '<div class=\"error\">' + e + '</div>';\n        if (window.widgeter && window.widgeter.autoResize) { setTimeout(() => window.widgeter.autoResize(document.documentElement.scrollWidth, document.documentElement.scrollHeight), 50); }\n    }\n}\n\ndocument.getElementById('refresh-btn').addEventListener('click', updateGit);\nupdateGit();\nsetInterval(updateGit, 60000); // refresh every minute",
  "setupHtml": "\n<h4>📦 Git Connection</h4>\n<p class=\"setup-description\">Set the path to the git repository you want to monitor.</p>\n<div class=\"form-group\">\n    <label>Repository Path</label>\n    <input type=\"text\" class=\"setup-repo-path\" placeholder=\"C:/Users/tobia/Widgeter\" />\n</div>\n<div class=\"setup-result\"></div>\n<div class=\"setup-actions\">\n    <button class=\"btn btn-save\">💾 Save</button>\n</div>",
  "setupJs": "\nconst panel = document.getElementById('setup-' + widget.id);\nconst repoPathInput = panel.querySelector('.setup-repo-path');\nconst saveBtn = panel.querySelector('.btn-save');\nconst resultEl = panel.querySelector('.setup-result');\n\nrepoPathInput.value = widget.config?.repo_path || '';\n\nsaveBtn.onclick = () => {\n    const repoPath = repoPathInput.value.trim();\n    const newConfig = { ...(widget.config || {}), repo_path: repoPath };\n    ipcRenderer.send('update-widget-config', widget.id, newConfig);\n    resultEl.className = 'test-result success';\n    resultEl.innerText = '✓ Saved! The widget will reload automatically.';\n};\n"
}