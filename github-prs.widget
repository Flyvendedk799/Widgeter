{
  "name": "GitHub Pull Requests",
  "width": 380,
  "height": 480,
  "html": "<div class='container'><div class='header'><div class='header-left'><span class='gh-icon'>&#x1F4CB;</span><h3>Pull Requests</h3></div><div class='header-right'><span id='pr-count' class='count-badge'>-</span><button class='no-drag refresh-btn' onclick='fetchPRs()'>&#x21BB;</button></div></div><div id='content'><div class='loading'><div class='spinner'></div><span>Loading...</span></div></div></div>",
  "css": "body {\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n  background: rgba(15, 15, 20, 0.95);\n  color: #e0e0e0;\n  margin: 0;\n  padding: 0;\n  border-radius: 12px;\n  border: 1px solid #333;\n  overflow: hidden;\n}\n.container {\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n}\n.header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12px 15px;\n  border-bottom: 1px solid #333;\n  background: rgba(20, 20, 25, 0.95);\n  position: sticky;\n  top: 0;\n  z-index: 10;\n}\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.gh-icon {\n  font-size: 18px;\n}\nh3 {\n  margin: 0;\n  color: #89b4fa;\n  font-size: 15px;\n  font-weight: 600;\n}\n.header-right {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.count-badge {\n  background: #333;\n  color: #a6adc8;\n  font-size: 11px;\n  padding: 2px 8px;\n  border-radius: 10px;\n  font-weight: 600;\n}\n.refresh-btn {\n  background: none;\n  border: 1px solid #444;\n  color: #a6adc8;\n  font-size: 16px;\n  width: 28px;\n  height: 28px;\n  border-radius: 6px;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.2s;\n}\n.refresh-btn:hover {\n  background: #333;\n  color: #fff;\n  border-color: #555;\n}\n#content {\n  flex: 1;\n  overflow-y: auto;\n  padding: 10px 12px;\n}\n#content::-webkit-scrollbar {\n  width: 5px;\n}\n#content::-webkit-scrollbar-thumb {\n  background-color: #444;\n  border-radius: 5px;\n}\n#content::-webkit-scrollbar-track {\n  background: transparent;\n}\n.loading {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  padding: 40px;\n  color: #666;\n}\n.spinner {\n  width: 24px;\n  height: 24px;\n  border: 2px solid #333;\n  border-top-color: #89b4fa;\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n}\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n.setup-prompt {\n  text-align: center;\n  padding: 30px 20px;\n}\n.setup-prompt .icon {\n  font-size: 36px;\n  margin-bottom: 10px;\n}\n.setup-prompt p {\n  color: #888;\n  font-size: 13px;\n  line-height: 1.5;\n}\n.empty-state {\n  text-align: center;\n  padding: 30px;\n}\n.empty-state .icon {\n  font-size: 32px;\n  margin-bottom: 8px;\n}\n.empty-state p {\n  color: #888;\n  font-size: 13px;\n}\n.error-state {\n  text-align: center;\n  padding: 20px;\n}\n.error-state p {\n  color: #f38ba8;\n  font-size: 12px;\n  margin-bottom: 10px;\n}\n.retry-btn {\n  background: #333;\n  border: 1px solid #555;\n  color: #cdd6f4;\n  padding: 5px 12px;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 12px;\n}\n.retry-btn:hover {\n  background: #444;\n}\n.pr-card {\n  background: rgba(255, 255, 255, 0.03);\n  border: 1px solid #2a2a35;\n  border-radius: 8px;\n  padding: 10px 12px;\n  margin-bottom: 8px;\n  transition: border-color 0.2s;\n}\n.pr-card:hover {\n  border-color: #444;\n}\n.pr-title {\n  font-size: 13px;\n  font-weight: 500;\n  color: #fff;\n  margin: 0 0 4px 0;\n  line-height: 1.3;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n.pr-number {\n  color: #89b4fa;\n  font-weight: 600;\n}\n.draft-badge {\n  background: rgba(249, 226, 175, 0.15);\n  color: #f9e2af;\n  font-size: 9px;\n  font-weight: 700;\n  padding: 1px 5px;\n  border-radius: 3px;\n  margin-left: 4px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n.pr-meta {\n  font-size: 11px;\n  color: #666;\n  margin-bottom: 8px;\n}\n.pr-meta .author {\n  color: #888;\n}\n.pr-meta .branch {\n  color: #585858;\n}\n.pr-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n}\n.action-btn {\n  font-size: 10px;\n  padding: 3px 8px;\n  border-radius: 4px;\n  border: 1px solid;\n  background: transparent;\n  cursor: pointer;\n  transition: all 0.2s;\n  font-family: inherit;\n  white-space: nowrap;\n}\n.action-btn:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n.btn-ready {\n  border-color: rgba(166, 227, 161, 0.3);\n  color: #a6e3a1;\n}\n.btn-ready:hover:not(:disabled) {\n  background: rgba(166, 227, 161, 0.15);\n}\n.btn-merge {\n  border-color: rgba(203, 166, 247, 0.3);\n  color: #cba6f7;\n}\n.btn-merge:hover:not(:disabled) {\n  background: rgba(203, 166, 247, 0.15);\n}\n.btn-open {\n  border-color: rgba(137, 180, 250, 0.3);\n  color: #89b4fa;\n}\n.btn-open:hover:not(:disabled) {\n  background: rgba(137, 180, 250, 0.15);\n}\n.btn-close {\n  border-color: rgba(243, 139, 168, 0.3);\n  color: #f38ba8;\n}\n.btn-close:hover:not(:disabled) {\n  background: rgba(243, 139, 168, 0.15);\n}",
  "js": "const https = require('https');\nconst { shell } = require('electron');\n\nlet ghToken = null;\nlet prs = [];\nlet actionInProgress = null;\nlet refreshTimer = null;\n\nfunction timeAgo(dateStr) {\n  var secs = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);\n  if (secs < 60) return 'just now';\n  var mins = Math.floor(secs / 60);\n  if (mins < 60) return mins + 'm ago';\n  var hrs = Math.floor(mins / 60);\n  if (hrs < 24) return hrs + 'h ago';\n  var days = Math.floor(hrs / 24);\n  return days + 'd ago';\n}\n\nfunction ghRequest(method, path, body, callback) {\n  var postData = body ? JSON.stringify(body) : null;\n  var opts = {\n    hostname: 'api.github.com',\n    path: path,\n    method: method,\n    headers: {\n      'Authorization': 'Bearer ' + ghToken,\n      'Accept': 'application/vnd.github+json',\n      'User-Agent': 'Widgeter',\n      'X-GitHub-Api-Version': '2022-11-28'\n    }\n  };\n  if (postData) {\n    opts.headers['Content-Type'] = 'application/json';\n    opts.headers['Content-Length'] = Buffer.byteLength(postData);\n  }\n  var req = https.request(opts, function(res) {\n    var data = '';\n    res.on('data', function(chunk) { data += chunk; });\n    res.on('end', function() {\n      var parsed = null;\n      try { parsed = JSON.parse(data); } catch(e) {}\n      callback(null, res.statusCode, parsed);\n    });\n  });\n  req.on('error', function(err) { callback(err, 0, null); });\n  req.setTimeout(15000, function() { req.destroy(); callback(new Error('Timeout'), 0, null); });\n  if (postData) req.write(postData);\n  req.end();\n}\n\nfunction renderSetupPrompt() {\n  document.getElementById('content').innerHTML = '<div class=\"setup-prompt\"><div class=\"icon\">&#x1F511;</div><p>Setup required.<br/>Open the <strong>Widgeter Dashboard</strong> and click <strong>&#x2699; Setup</strong> on this widget to connect your GitHub account.</p></div>';\n  document.getElementById('pr-count').innerText = '-';\n}\n\nfunction renderLoading() {\n  document.getElementById('content').innerHTML = '<div class=\"loading\"><div class=\"spinner\"></div><span>Loading...</span></div>';\n}\n\nfunction renderError(msg) {\n  document.getElementById('content').innerHTML = '<div class=\"error-state\"><p>' + msg + '</p><button class=\"no-drag retry-btn\" onclick=\"fetchPRs()\">Retry</button></div>';\n}\n\nfunction renderEmpty() {\n  document.getElementById('content').innerHTML = '<div class=\"empty-state\"><div class=\"icon\">&#x1F389;</div><p>No open pull requests!</p></div>';\n  document.getElementById('pr-count').innerText = '0';\n}\n\nfunction renderPRs() {\n  document.getElementById('pr-count').innerText = prs.length.toString();\n  var html = '';\n  prs.forEach(function(pr) {\n    var isDraft = pr.draft;\n    var disabled = actionInProgress === pr.number ? ' disabled' : '';\n    var loadingText = actionInProgress === pr.number ? '...' : '';\n    var repoFullName = pr.repository_url.split('/repos/')[1];\n    \n    html += '<div class=\"pr-card\">';\n    html += '<div class=\"pr-title\"><span class=\"pr-number\">#' + pr.number + '</span> ' + escapeHtml(pr.title);\n    if (isDraft) html += ' <span class=\"draft-badge\">Draft</span>';\n    html += '</div>';\n    html += '<div class=\"pr-meta\"><span class=\"author\">' + escapeHtml(pr.user.login) + '</span> &middot; <span class=\"branch\">' + escapeHtml(repoFullName) + '</span> &middot; ' + timeAgo(pr.created_at) + '</div>';\n    html += '<div class=\"pr-actions no-drag\">';\n    if (isDraft) {\n      html += '<button class=\"action-btn btn-ready no-drag\"' + disabled + ' onclick=\"handleAction(' + pr.number + ', \\'ready\\', \\'' + repoFullName + '\\')\">' + (loadingText || '&#x2705; Ready') + '</button>';\n    }\n    html += '<button class=\"action-btn btn-merge no-drag\"' + disabled + ' onclick=\"handleAction(' + pr.number + ', \\'merge\\', \\'' + repoFullName + '\\')\">' + (loadingText || '&#x1F500; Merge') + '</button>';\n    html += '<button class=\"action-btn btn-open no-drag\" onclick=\"openPR(\\'' + pr.html_url + '\\')\">' + '&#x2197; GitHub</button>';\n    html += '<button class=\"action-btn btn-close no-drag\"' + disabled + ' onclick=\"handleAction(' + pr.number + ', \\'close\\', \\'' + repoFullName + '\\')\">' + (loadingText || '&#x2716; Close') + '</button>';\n    html += '</div></div>';\n  });\n  document.getElementById('content').innerHTML = html;\n}\n\nfunction escapeHtml(str) {\n  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n}\n\nwindow.fetchPRs = function() {\n  if (!ghToken) { renderSetupPrompt(); return; }\n  if (prs.length === 0) renderLoading();\n  // Fetch PRs that involve the authenticated user (authored, requested review, assigned, etc.)\n  ghRequest('GET', '/search/issues?q=is:pr+is:open+involves:@me&sort=updated&order=desc&per_page=15', null, function(err, status, data) {\n    if (err) { renderError('Network error: ' + err.message); return; }\n    if (status !== 200) { renderError((data && data.message) || 'GitHub API error: ' + status); return; }\n    if (!data.items || !Array.isArray(data.items)) { renderError('Unexpected response from GitHub'); return; }\n    prs = data.items;\n    if (prs.length === 0) { renderEmpty(); } else { renderPRs(); }\n  });\n};\n\nwindow.openPR = function(url) {\n  shell.openExternal(url);\n};\n\nwindow.handleAction = function(prNumber, action, repoFullName) {\n  if (!ghToken) return;\n  actionInProgress = prNumber;\n  renderPRs();\n  var method, path, body;\n  switch (action) {\n    case 'ready':\n      method = 'PATCH';\n      path = '/repos/' + repoFullName + '/pulls/' + prNumber;\n      body = { draft: false };\n      break;\n    case 'merge':\n      method = 'PUT';\n      path = '/repos/' + repoFullName + '/pulls/' + prNumber + '/merge';\n      body = { merge_method: 'squash' };\n      break;\n    case 'close':\n      method = 'PATCH';\n      path = '/repos/' + repoFullName + '/pulls/' + prNumber;\n      body = { state: 'closed' };\n      break;\n    default: return;\n  }\n  ghRequest(method, path, body, function(err, status, data) {\n    actionInProgress = null;\n    if (err || (status < 200 || status >= 300)) {\n      var msg = err ? err.message : ((data && data.message) || 'Action failed');\n      renderError(msg);\n      setTimeout(fetchPRs, 3000);\n      return;\n    }\n    fetchPRs();\n  });\n};\n\nasync function init() {\n  ghToken = await window.widgeter.getConfig('github_token');\n  fetchPRs();\n  refreshTimer = setInterval(fetchPRs, 60000);\n}\n\ninit();",
  "setupHtml": "\n<h4>🔑 GitHub Connection</h4>\n<p class=\"setup-description\">Connect your GitHub account to view all pull requests you are involved in.</p>\n<div class=\"form-group\">\n    <label>Personal Access Token</label>\n    <input type=\"password\" class=\"setup-token\" placeholder=\"ghp_xxxxxxxxxxxx\" />\n    <div class=\"hint\">Requires <strong>repo</strong> scope. <a href=\"https://github.com/settings/tokens/new?scopes=repo&description=Widgeter\" onclick=\"require('electron').shell.openExternal(this.href); return false;\">Create token →</a></div>\n</div>\n<div class=\"setup-result\"></div>\n<div class=\"setup-actions\">\n    <button class=\"btn btn-save\">💾 Save</button>\n    <button class=\"btn btn-disconnect\" style=\"background-color: #f38ba8; display: none;\">Disconnect</button>\n</div>",
  "setupJs": "\nconst panel = document.getElementById('setup-' + widget.id);\nconst tokenInput = panel.querySelector('.setup-token');\nconst resultEl = panel.querySelector('.setup-result');\nconst saveBtn = panel.querySelector('.btn-save');\nconst disconnectBtn = panel.querySelector('.btn-disconnect');\n\ntokenInput.value = widget.config?.github_token || '';\nif (tokenInput.value) {\n    disconnectBtn.style.display = 'inline-block';\n}\n\nsaveBtn.onclick = () => {\n    const token = tokenInput.value.trim();\n    if (!token) {\n        alert('Personal Access Token is required.');\n        return;\n    }\n    const newConfig = { ...(widget.config || {}), github_token: token };\n    delete newConfig.github_repo; // Clean up old config\n    ipcRenderer.send('update-widget-config', widget.id, newConfig);\n    resultEl.className = 'test-result success';\n    resultEl.innerText = '✓ Saved! The widget will reload automatically.';\n};\n\ndisconnectBtn.onclick = () => {\n    const newConfig = { ...(widget.config || {}) };\n    delete newConfig.github_token;\n    delete newConfig.github_repo;\n    ipcRenderer.send('update-widget-config', widget.id, newConfig);\n    tokenInput.value = '';\n    disconnectBtn.style.display = 'none';\n    resultEl.className = 'test-result success';\n    resultEl.innerText = '✓ Disconnected.';\n};\n"
}